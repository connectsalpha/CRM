{
  "name": "alpha-crm-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "build": "npm run prisma:generate && npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
